rules_version = '2';

// Firestore Security Rules — S-Tier Eats
//
// Source of truth in the repo. Deploy via the Firebase Console:
//   1. console.firebase.google.com → S-Tier Eats project
//   2. Firestore Database → Rules tab
//   3. Replace the editor contents with this file
//   4. Click Publish
//
// Schema reference: docs/firestore-schema.md
//
// IDENTITY MODEL (Phase 3 — full-backfill decision):
//   • AUTH is anonymous Firebase Auth: request.auth.uid is the Firebase anon
//     UID. It proves "a real app instance is signed in," nothing more.
//   • The CANONICAL user key on every user-owned doc is the iCloud user record
//     name (so live dual-writes and the one-time CloudKit→Firestore backfill
//     share one id and the same person never double-counts).
//   • Because the doc's userID (iCloud id) is NOT the auth uid (Firebase id),
//     rules CANNOT enforce "auth.uid == doc.userID". User-owned writes are
//     therefore gated only on "signed in" (isAuthed). This mirrors the trust
//     model CloudKit already uses today — the app parses a client-asserted
//     userID out of each record name, and the admin audit / ban / exclusion
//     tools police manipulation. (Minting a Firebase custom token whose uid ==
//     the iCloud id would restore per-user authz, but needs a server / Blaze
//     plan — out of scope for now.)
//   • ADMIN authority still IS keyed by the Firebase uid: the /users/{uid}
//     admin flag is looked up by request.auth.uid, so isAdmin() is real.
//     Admin-only collections stay strict.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── placements — user tier rankings ──────────────────────────
    // Public read (community consensus). Any signed-in user may write; the
    // userID field is client-asserted (see identity model).
    match /placements/{docID} {
      allow read:  if true;
      allow write: if isAuthed();
    }

    // ── closureReports — user "permanently closed" reports ────────
    match /closureReports/{docID} {
      allow read:  if true;
      allow write: if isAuthed();
    }

    // ── closureDecisions — admin verdict on closure ──────────────
    match /closureDecisions/{restaurantID} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── profiles — identity + Foodie Pro request status ──────────
    // Any signed-in user may write their card, but nobody can self-set
    // status "approved" — that path stays admin-only. (In practice the
    // profile status is only ever "" or "requested"; approval lives in the
    // separate proApprovals collection.)
    match /profiles/{userID} {
      allow read: if true;
      allow write: if isAuthed()
        && (!('status' in request.resource.data)
            || request.resource.data.status != 'approved'
            || isAdmin());
    }

    // ── proApprovals — admin-verified Foodie Pros ────────────────
    match /proApprovals/{userID} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── dishPhotos — user-uploaded photo metadata ────────────────
    // (Binary lives in Cloud Storage; iOS does not yet write this collection
    // — photo binary is deferred to the Firebase Storage task.)
    match /dishPhotos/{photoID} {
      allow read:   if true;
      allow create: if isAuthed();
      allow delete: if isAdmin();
    }

    // ── photoReports — reports of objectionable photos ───────────
    match /photoReports/{docID} {
      allow read:   if isAdmin();
      allow create: if isAuthed();
    }

    // ── photoModerated — admin verdict on reported photos ────────
    match /photoModerated/{photoID} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── suggestions — user-submitted missing restaurants ─────────
    match /suggestions/{suggestionID} {
      allow read:   if true;
      allow create: if isAuthed()
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── liveRestaurants — admin-approved community additions ─────
    match /liveRestaurants/{restaurantID} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── visitedLists — per-user visited set ──────────────────────
    // Low-sensitivity personal data (which restaurants you've been to). Under
    // the anon-auth model we can't scope to the owner, so it's readable/
    // writable by any signed-in user, consistent with the rest.
    match /visitedLists/{userID} {
      allow read, write: if isAuthed();
    }

    // ── dietaryTags — community dietary/needs confirmations ──────
    match /dietaryTags/{docID} {
      allow read:  if true;
      allow write: if isAuthed();
    }

    // ── friendLists — per-user follow graph ──────────────────────
    match /friendLists/{userID} {
      allow read, write: if isAuthed();
    }

    // ── noteReports — reports of objectionable placement notes ───
    match /noteReports/{docID} {
      allow read:   if isAdmin();
      allow create: if isAuthed();
    }

    // ── adminExclusions — integrity markers (ban/exclude/hide) ───
    match /adminExclusions/{docID} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── users — admin flag store (keyed by Firebase auth uid) ────
    // This collection alone is keyed by request.auth.uid, so ownership CAN be
    // enforced. Bootstrap the first admin doc manually via the Console.
    match /users/{userID} {
      allow read:  if isAuthed() && (request.auth.uid == userID || isAdmin());
      allow write: if isAdmin();
    }
  }
}
